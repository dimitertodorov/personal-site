{
  "name": "personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5181 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node tools/build-cv.ts && vite build",
    "build:static": "tsc --noEmit && node tools/build-cv.ts && popfold build",
    "preview": "vite preview",
    "deploy:site": "pnpm build:static && wrangler deploy",
    "cv": "node tools/build-cv.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "popfold": "npm:@popfold/engine@0.50.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.18.0"
}
